# Moonlight Kitchen - Environment Configuration
# Copy this file to .env to connect your Supabase backend (optional; app works out-of-the-box with local fallback)

# Supabase Project URL (e.g. https://xyzcompany.supabase.co)
VITE_SUPABASE_URL=

# Supabase Anon Public Key
VITE_SUPABASE_ANON_KEY=

# Restaurant WhatsApp Ordering Number (digits only, e.g. 917666445477)
VITE_RESTAURANT_WHATSAPP=917666445477
